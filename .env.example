# AYLAND settings (HANDBOOK §12). Copy to .env (gitignored) and fill in the blanks.
# Never commit .env or paste keys in chat groups: the repo is public.

# --- Database (M0-2). Atlas → Connect → Drivers → Python: copy the mongodb+srv:// string
#     and replace <db_password> with your database user's password.
MONGODB_URI=
MONGODB_DB=ayland

# --- Claude (M0-3): no API key. AYLAND calls Claude through your Claude Code login.
#     Leave the path empty to auto-detect (`claude` on PATH, then the VS Code extension's copy).
CLAUDE_CLI_PATH=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
CLAUDE_CHAT_EFFORT=low

# --- Novelsoft (hackathon requirement): OyuLLM, Anir STT, tsuurAI TTS share one key.
#     Create it at https://oyu.so/account/apikeys (comes with free credit).
OYU_API_KEY=
OYU_BASE_URL=https://api.oyu.so/v1
OYU_LLM_MODEL=oyuLLM
OYU_STT_MODEL=v4
OYU_TTS_VOICE=mbspeech

# --- Local service URLs (HANDBOOK §5.1)
ORCHESTRATOR_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
MCP_TRAVEL_DATA_URL=http://localhost:8201/mcp
MCP_MERCHANT_URL=http://localhost:8202/mcp
A2A_BOOKING_URL=http://localhost:8301
A2A_INTERPRETER_URL=http://localhost:8302

# --- Frontend build (not read from this file: put them in frontend/.env.local, or the Vercel project, §12)
# AYLAND_API_ORIGIN=http://localhost:8000      where /api is proxied (the backend's tunnel URL on Vercel)
# NEXT_PUBLIC_AYLAND_MODE=mock                 mock (default) or live, the mode visitors start in

# --- Demo (HANDBOOK §3)
DEMO_MODE=true
DEMO_SCENARIO=hanoi_rain
DEMO_NOW=10:30
